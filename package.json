{
  "name": "floorvote",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w api\" \"npm run dev -w web\"",
    "dev:local": "bash scripts/dev-local.sh",
    "gen:email-icons": "tsx scripts/gen-email-icons.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:deploy": "rm -rf docs/.vitepress/dist && npm run docs:build && wrangler deploy -c docs/wrangler.toml"
  },
  "workspaces": [
    "api",
    "web"
  ],
  "devDependencies": {
    "@material-symbols/svg-400": "^0.45.8",
    "@resvg/resvg-js": "^2.6.2",
    "concurrently": "^10.0.3",
    "fflate": "^0.8.3",
    "mermaid": "^11.16.0",
    "tsx": "^4.23.1",
    "vite": "^8.1.5",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "wrangler": "^4"
  }
}
