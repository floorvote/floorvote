{
  "name": "floorvote",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w api\" \"npm run dev -w web\"",
    "dev:local": "bash scripts/dev-local.sh",
    "test": "vitest run",
    "test:scripts": "vitest run --project scripts",
    "verify:timestamps": "tsx scripts/verify-timestamp-writes.ts",
    "gen:email-icons": "tsx scripts/gen-email-icons.ts",
    "gen:brand-assets": "tsx scripts/gen-brand-assets.ts",
    "gen:state-coverage": "tsx scripts/gen-state-coverage.ts",
    "gen:codeowners": "tsx scripts/gen-codeowners.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:deploy": "rm -rf docs/.vitepress/dist && npm run docs:build && wrangler deploy -c docs/wrangler.toml",
    "screenshot:bill-early-vote": "node scripts/example-screenshots/capture.mjs"
  },
  "workspaces": [
    "api",
    "web"
  ],
  "devDependencies": {
    "@material-symbols/svg-400": "^0.48.1",
    "@resvg/resvg-js": "^2.6.2",
    "concurrently": "^10.0.6",
    "fflate": "^0.8.3",
    "mermaid": "^11.17.2",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.5",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "^7.30.0",
    "sharp": "^0.35.5",
    "@cloudflare/vitest-pool-workers": {
      "undici": "^7.30.0",
      "sharp": "^0.35.5"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "vitepress": {
      "vite": "^6.4.4"
    },
    "katex": "^0.19.0",
    "shell-quote": "^1.12.0"
  }
}
