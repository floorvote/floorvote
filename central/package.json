{
  "name": "central",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --env legiscan",
    "deploy": "npm run deploy:central",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings 0 && node scripts/check-provider-boundary.mjs",
    "build:web": "cd web && npm install && npm run build",
    "deploy:central": "npm run build:web && npm run migrate:central:remote && wrangler deploy --env legiscan && npm run smoke:central",
    "postdeploy:central": "bash scripts/backup-config.sh",
    "smoke:central": "node scripts/smoke-text.mjs",
    "migrate:local": "npm run migrate:central:local",
    "migrate:remote": "npm run migrate:central:remote",
    "migrate:central:local": "wrangler d1 migrations apply central-bills-ls --local --env legiscan",
    "migrate:central:remote": "wrangler d1 migrations apply central-bills-ls --remote --env legiscan",
    "deploy:legiscan": "npm run build:web && npm run migrate:legiscan:remote && wrangler deploy --env legiscan && npm run smoke:legiscan",
    "postdeploy:legiscan": "bash scripts/backup-config.sh",
    "smoke:legiscan": "npm run smoke:central",
    "migrate:legiscan:local": "npm run migrate:central:local",
    "migrate:legiscan:remote": "npm run migrate:central:remote"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/adm-zip": "^0.6.0",
    "adm-zip": "^0.6.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "undici": "^7.30.0",
    "sharp": "^0.35.5",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
