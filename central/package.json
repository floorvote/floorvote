{
  "name": "central",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --env legiscan",
    "deploy": "npm run deploy:legiscan",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings 0 && node scripts/check-provider-boundary.mjs",
    "build:web": "cd web && npm install && npm run build",
    "deploy:legiscan": "npm run build:web && npm run migrate:legiscan:remote && wrangler deploy --env legiscan && npm run smoke:legiscan",
    "postdeploy:legiscan": "bash scripts/backup-config.sh",
    "smoke:legiscan": "node scripts/smoke-text.mjs",
    "migrate:local": "npm run migrate:legiscan:local",
    "migrate:remote": "npm run migrate:legiscan:remote",
    "migrate:legiscan:local": "wrangler d1 migrations apply central-bills-ls --local --env legiscan",
    "migrate:legiscan:remote": "wrangler d1 migrations apply central-bills-ls --remote --env legiscan"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "undici": "^7.30.0",
    "sharp": "^0.35.5",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
