    <summaries>
      <summary>
        <versionCode>00</versionCode>
        <actionDate>2025-01-13</actionDate>
        <actionDesc>Introduced in House</actionDesc>
        <updateDate>2025-02-27T19:54:41Z</updateDate>
        <text><![CDATA[<p><strong>Make Greenland Great Again Act</strong></p><p>This bill authorizes the President to seek to enter into negotiations with Denmark to acquire Greenland.</p><p>If such an agreement is reached, the President must transmit the agreement and related materials to Congress within five calendar days.&nbsp;The agreement shall go into effect 60 calendar days after such transmission unless Congress enacts a joint resolution of disapproval.</p>]]></text>
      </summary>
    </summaries>
