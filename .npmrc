supported-architectures.os=linux,darwin
supported-architectures.cpu=x64,arm64
# eslint-plugin-jsx-a11y (a11y lint) peers eslint <=9; this repo is on eslint 10.
# Persist legacy peer resolution so local installs, `npm ci`, and CI all compute
# the dependency tree identically (otherwise `npm ci` reports a phantom
# out-of-sync on an optional peer that legacy mode prunes).
legacy-peer-deps=true
