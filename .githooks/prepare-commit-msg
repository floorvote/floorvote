#!/usr/bin/env bash
# Append a DCO `Signed-off-by` trailer when the message does not already have one.
#
# This repo runs the Probot DCO check on every PR, and it fails unless EVERY
# commit carries `Signed-off-by: Name <email>`. Nothing local enforced that, so
# the failure only ever surfaced on an already-open PR, where the fix is an
# amend plus a force-push. This moves the cost to commit time, where it is free.
#
# Requires `git config core.hooksPath .githooks` — see AGENTS.md.
#
# `git commit -s` stays a no-op here: the trailer is only added when absent.

msg_file="$1"
src="$2"

# Skip messages we are not authoring: `merge` and `squash` templates are
# assembled from commits that already carry (or deliberately lack) their own
# trailers, and `template` is a configured commit.template being laid down.
case "$src" in
  merge|squash|template) exit 0 ;;
esac

# Already signed — including by `git commit -s`, which runs before this hook.
if grep -qiE '^Signed-off-by:' "$msg_file"; then
  exit 0
fi

# Sign off as the person git will record as the AUTHOR, which is not always
# `user.name`/`user.email` — `--author`, `-C`, and a rebase of someone else's
# commit all override it. DCO matches the trailer against the author, so reading
# the author back from git is the only way to get this right; falling back to
# user.* when git has no author yet (the ordinary case) is correct.
name=$(git var GIT_AUTHOR_IDENT 2>/dev/null | sed -n 's/^\(.*\) <.*/\1/p')
email=$(git var GIT_AUTHOR_IDENT 2>/dev/null | sed -n 's/^.*<\([^>]*\)>.*/\1/p')

# No identity configured: say so rather than writing a malformed trailer that
# would fail DCO anyway, and let the commit proceed.
if [ -z "$name" ] || [ -z "$email" ]; then
  echo "prepare-commit-msg: no git identity, skipping DCO sign-off" >&2
  exit 0
fi

printf '\nSigned-off-by: %s <%s>\n' "$name" "$email" >> "$msg_file"
