#!/usr/bin/env bash
# Append a DCO `Signed-off-by` trailer when the message does not already have one.
#
# This repo runs the Probot DCO check on every PR, and it fails unless EVERY
# commit carries `Signed-off-by: Name <email>`. Nothing local enforced that, so
# the failure only ever surfaced on an already-open PR, where the fix is an
# amend plus a force-push. This moves the cost to commit time, where it is free.
#
# Requires `git config core.hooksPath .githooks` — see AGENTS.md.
#
# Note: `--no-verify` skips pre-commit and commit-msg, but whether it skips
# prepare-commit-msg varies by git version — do not rely on it to opt out.
#
# `git commit -s` stays a no-op here: the trailer is only added when absent.

msg_file="$1"
src="$2"

# Skip messages we are not authoring: `merge` and `squash` templates are
# assembled from commits that already carry (or deliberately lack) their own
# trailers, and `template` is a configured commit.template being laid down.
case "$src" in
  merge|squash|template) exit 0 ;;
esac

# Already signed — including by `git commit -s`, which runs before this hook.
if grep -qiE '^Signed-off-by:' "$msg_file"; then
  exit 0
fi

# The trailer must name the commit's AUTHOR, which is not always the configured
# user — `--author`, `-C`, and cherry-picking someone else's patch all override it.
name=$(git var GIT_AUTHOR_IDENT 2>/dev/null | sed -n 's/^\(.*\) <.*/\1/p')
email=$(git var GIT_AUTHOR_IDENT 2>/dev/null | sed -n 's/^.*<\([^>]*\)>.*/\1/p')

# No identity configured: say so rather than writing a malformed trailer that
# would fail DCO anyway, and let the commit proceed.
if [ -z "$name" ] || [ -z "$email" ]; then
  echo "prepare-commit-msg: no git identity, skipping DCO sign-off" >&2
  exit 0
fi

# ONLY ever sign off on your own work.
#
# The sign-off is an assertion under the Developer Certificate of Origin — the
# author certifying they have the right to submit that code under the project's
# license. It is a statement only the author can truthfully make. So when the
# author is somebody else, adding it here would fabricate their certification,
# which is a worse failure than the CI red it avoids: DCO exists precisely to
# record that the author made this promise.
#
# Leaving it unsigned makes the DCO check fail loudly, which is the correct
# outcome — a human then decides whether to ask the author to sign, or to add
# their own sign-off as a co-author deliberately.
configured=$(git config user.email 2>/dev/null)
if [ "$email" != "$configured" ]; then
  echo "prepare-commit-msg: author is <$email>, not you (<$configured>) — not signing off on their behalf." >&2
  echo "                    If you have the right to certify this work, sign it yourself: git commit --amend -s" >&2
  exit 0
fi

printf '\nSigned-off-by: %s <%s>\n' "$name" "$email" >> "$msg_file"
