    <tr><td style="padding:0 14px 6px 14px;background:#f8fafc;font-size:10px;color:#5e697d;">Set a priority or dismiss each from the bill list.</td></tr>
    <tr><td style="padding:0 14px 8px 14px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tbody><tr>
      <td style="padding:8px 0;border-top:1px solid #e2e8f0;">
        <a href="https://x.test/RI/2026/HB 1602" style="text-decoration:none;">
          <span style="display:inline-block;background:#1e3a5f;color:#fff;font-size:12px;font-weight:700;padding:3px 10px;border-radius:4px;letter-spacing:0.02em;">RI HB 1602</span>
          <span style="color:#0f172a;font-size:12px;font-family:'Source Serif 4', Georgia, serif;margin-left:8px;">Automatic voter registration at the DMV</span>
