        <a href="https://x.test/RI/2026/S 0712" style="text-decoration:none;">
          <span style="display:inline-block;background:#1e3a5f;color:#fff;font-size:12px;font-weight:700;padding:3px 10px;border-radius:4px;letter-spacing:0.02em;">RI S 0712</span>
          <span style="color:#0f172a;font-size:12px;font-family:'Source Serif 4', Georgia, serif;margin-left:8px;">Ranked-choice voting for municipal elections</span>
        </a>
      </td>
    </tr>
<tr>
      <td style="padding:8px 0;border-top:1px solid #e2e8f0;">
        <a href="https://x.test/RI/2026/HB 1455" style="text-decoration:none;">
          <span style="display:inline-block;background:#1e3a5f;color:#fff;font-size:12px;font-weight:700;padding:3px 10px;border-radius:4px;letter-spacing:0.02em;">RI HB 1455</span>
          <span style="color:#0f172a;font-size:12px;font-family:'Source Serif 4', Georgia, serif;margin-left:8px;">Poll worker compensation increase</span>
        </a>
      </td>
    </tr></tbody></table>
    </td></tr>
