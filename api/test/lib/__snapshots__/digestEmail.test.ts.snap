          <td align="right" style="vertical-align:middle;"><span style="display:inline-block;background:#850028;color:#fff;font-size:12px;font-weight:600;padding:3px 10px;border-radius:4px;white-space:nowrap;">High priority</span></td>
        </tr></tbody></table>
