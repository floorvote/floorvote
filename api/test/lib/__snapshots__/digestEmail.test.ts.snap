          <tr><td style="padding:6px 20px 28px;">
            
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:18px;border:1px solid #e2e8f0;border-radius:8px;overflow:hidden;">
  <tbody>
