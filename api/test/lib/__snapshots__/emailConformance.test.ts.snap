exports[`email conformance — every sample type shares the shell contract > email-change-changed > matches its committed snapshot 1`] = `
"<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"></head>
<body style="margin:0;padding:0;background:#f8fafc;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f8fafc;padding:32px 0;">
    <tbody><tr><td align="center">
      <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;">
        <tbody>
          <tr><td style="padding:0 20px 18px;">
            
  <div style="margin-bottom:4px;">
    <img src="https://sample.test/email-icons/wordmark.png" alt="FloorVote" width="150" height="24" style="display:block;border:0;height:auto;">
  </div>

            <p style="margin:0;font-size:12px;font-weight:600;color:#5e697d;">Rhode Island Association of Local Election Officials</p>
            <p style="margin:18px 0 0;font-size:18px;font-weight:700;color:#0f172a;line-height:1.35;">Your sign-in email was changed</p>
            
          </td></tr>
          <tr><td style="padding:6px 20px 28px;">
            <p style="margin:0 0 14px;font-size:14px;line-height:1.6;color:#374151;">The sign-in email for your FloorVote account at Rhode Island Association of Local Election Officials is now <strong>d***@newcounty.gov</strong>. This address no longer signs you in, sign-in links already sent here have stopped working, and the account was signed out everywhere except the device that asked for the change.</p><p style="margin:0;font-size:14px;line-height:1.6;color:#374151;">If you made this change, you don't need to do anything. If you didn't, use the link below.</p>
            <div style="margin-top:18px;"><a href="https://sample.test/auth/not-me?token=sample-link-not-functional" style="display:inline-block;background:#3b82f6;color:#fff;text-decoration:none;font-size:14px;font-weight:600;padding:12px 24px;border-radius:6px;">This wasn't me</a></div>
          </td></tr>
          <tr><td style="padding:22px 20px 4px;border-top:1px solid #e2e8f0;text-align:center;">
            This is an account security notice, so it's sent even if you've turned off other emails.<br><a href="https://sample.test" style="font-size:12px;color:#667386;text-decoration:underline;">FloorVote</a>
          </td></tr>
        </tbody>
      </table>
    </td></tr></tbody>
  </table>
</body>
</html>"
`;

exports[`email conformance — every sample type shares the shell contract > email-change-confirm > matches its committed snapshot 1`] = `
"<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"></head>
<body style="margin:0;padding:0;background:#f8fafc;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f8fafc;padding:32px 0;">
    <tbody><tr><td align="center">
      <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;">
        <tbody>
          <tr><td style="padding:0 20px 18px;">
            
  <div style="margin-bottom:4px;">
    <img src="https://sample.test/email-icons/wordmark.png" alt="FloorVote" width="150" height="24" style="display:block;border:0;height:auto;">
  </div>

            <p style="margin:0;font-size:12px;font-weight:600;color:#5e697d;">Rhode Island Association of Local Election Officials</p>
            <p style="margin:18px 0 0;font-size:18px;font-weight:700;color:#0f172a;line-height:1.35;">Confirm your new email</p>
            
          </td></tr>
          <tr><td style="padding:6px 20px 28px;">
            <p style="margin:0 0 14px;font-size:14px;line-height:1.6;color:#374151;">Someone asked to make this the sign-in email for their FloorVote account at Rhode Island Association of Local Election Officials. If that was you, use the button below, then press Confirm new email on the page it opens. Nothing changes until you do.</p><p style="margin:0;font-size:14px;line-height:1.6;color:#374151;">The link expires in 24 hours and works once. Opening it doesn't sign you in.</p>
            <div style="margin-top:18px;"><a href="https://sample.test/auth/confirm-email?token=sample-link-not-functional" style="display:inline-block;background:#3b82f6;color:#fff;text-decoration:none;font-size:14px;font-weight:600;padding:12px 24px;border-radius:6px;">Confirm new email</a></div>
          </td></tr>
          <tr><td style="padding:22px 20px 4px;border-top:1px solid #e2e8f0;text-align:center;">
            If you didn't ask for this, you can ignore this email. Nobody can use this address to sign in unless it's confirmed.<br><a href="https://sample.test" style="font-size:12px;color:#667386;text-decoration:underline;">FloorVote</a>
          </td></tr>
        </tbody>
      </table>
    </td></tr></tbody>
  </table>
</body>
</html>"
`;

