      <td colspan="3" style="padding:2px 14px 4px 14px;font-family:'Source Serif 4', Georgia, serif;font-size:14px;color:#0f172a;font-weight:700;line-height:1.35;"><a href="https://sample.test/RI/2026/HB 1234" style="color:inherit;text-decoration:none;">Voter ID Act</a></td>
