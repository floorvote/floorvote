"<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"></head>
<body style="margin:0;padding:0;background:#f8fafc;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f8fafc;padding:32px 0;">
    <tbody><tr><td align="center">
      <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;">
        <tbody>
          <tr><td style="padding:0 20px 18px;">
            
  <div style="margin-bottom:4px;font-size:18px;font-weight:800;letter-spacing:-0.02em;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;">
    <span style="color:#1e3a5f;">Floor</span><span style="color:#f59e0b;">Vote</span>
  </div>

            <p style="margin:0;font-size:12px;font-weight:600;color:#5e697d;">Rhode Island Association of Local Election Officials</p>
            <p style="margin:18px 0 0;font-size:18px;font-weight:700;color:#0f172a;line-height:1.35;">You've been invited</p>
            
          </td></tr>
          <tr><td style="padding:6px 20px 28px;">
            <p style="margin:0;font-size:14px;line-height:1.6;color:#374151;">You've been added to Rhode Island Association of Local Election Officials on FloorVote, a legislative tracking tool. Click below to set up your account. This link expires in 7 days and can only be used once. You can also <a href="https://sample.test" style="color: #2563eb;">request a new sign-in link</a> anytime using this email address.</p>
            <div style="margin-top:18px;"><a href="https://sample.test/login?token=sample-link-not-functional" style="display:inline-block;background:#3b82f6;color:#fff;text-decoration:none;font-size:14px;font-weight:600;padding:12px 24px;border-radius:6px;">Accept your invitation</a></div>
          </td></tr>
          <tr><td style="padding:22px 20px 4px;border-top:1px solid #e2e8f0;text-align:center;">
            If you didn't expect this email, you can safely ignore it.<br><a href="https://sample.test" style="font-size:12px;color:#667386;text-decoration:underline;">FloorVote</a>
          </td></tr>
        </tbody>
      </table>
    </td></tr></tbody>
  </table>
</body>
</html>"
`;

