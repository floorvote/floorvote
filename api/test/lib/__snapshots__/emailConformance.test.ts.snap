<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:18px;border:1px solid #e2e8f0;border-radius:8px;overflow:hidden;">
  <tbody>
    <tr><td style="padding:12px 14px 4px 14px;background:#f8fafc;font-size:14px;font-weight:700;color:#0f172a;">New bills matching your keywords</td></tr>
    <tr><td style="padding:0 14px 6px 14px;background:#f8fafc;font-size:10px;color:#5e697d;">Set a priority or dismiss each from the bill list.</td></tr>
