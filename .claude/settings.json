{
  "permissions": {
    "allow": [
      "Bash(git merge*)",
      "Bash(git push*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "EnterWorktree|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-base-reminder.sh"
          }
        ]
      }
    ]
  }
}
