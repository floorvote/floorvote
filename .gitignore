node_modules/
node_modules
dist/
.wrangler/
.dev.vars
*.local
.env
.env.secrets
.DS_Store
tsconfig.tsbuildinfo

# Real wrangler config (contains account IDs, database IDs, custom domains).
# Ship *.example.toml only; copy to wrangler.toml and fill in your values.
api/wrangler.toml
central/wrangler.toml

# VitePress build output
docs/.vitepress/dist/
docs/.vitepress/cache/

# Claude Code personal overrides (settings.json and launch.json are shared)
.claude/settings.local.json
.claude/worktrees/

# Git worktrees
.worktrees/

# graphify: track graph.json and GRAPH_REPORT.md (nightly CI regenerates).
# Ignore everything else (build cache, HTML viewer, backups).
graphify-out/graph.html
graphify-out/cost.json
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/cache/
graphify-out/wiki/
graphify-out/20*/

# Legal docs: operators' real Terms/Privacy stay untracked until a deliberate
# `git add -f` at launch. Only the *.example.md placeholders ship.
docs/legal/*.md
!docs/legal/*.example.md

# Editor / tool workspaces under docs (local only)
docs/.obsidian/
docs/.claudian/

# LegiScan bulk datasets, extracted from legiscan.com/gaits/datasets to seed a
# new state (see docs/content/self-hosting/tenants.md, "Path B"). Hundreds of MB
# of JSON per session — working input, never committed. Both spellings are
# ignored because the docs and scripts have used each.
bulkseed/
bulkseeds/

# Superpowers plans and specs. These are working documents for a private
# workflow and are kept in the BPC fork, not in the public repository. Ignored
# here so a plan written while working in this clone can't be committed by
# accident once this repo is public. The fork re-includes the path at the end
# of its own .gitignore.
docs/superpowers/
